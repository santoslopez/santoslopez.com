---
import GitHubIcon from "./icons/GitHubIcon.astro";

import { Image } from "astro:assets"; 



const {
    id,
    tituloTema,
    fechaPublicacion,
    descripcionPrevia,
    imagenPrevia,
    tecnologias = [],
    enlace,
    mostrarEnlaceGitHub
} = Astro.props;
---
<article class="project">
    <Image src={imagenPrevia} alt={tituloTema} class="project-image"/>
    <!--p>
    mostrarEnlaceGitHub = {String(mostrarEnlaceGitHub)}
</p-->
    <div class="project-info">
        <h2><a href={`/proyectos/${id}`}>{tituloTema}</a></h2>
         <p>{ fechaPublicacion}</p>           

        <p>Descripción previa: {descripcionPrevia}</p>
        <p>Tecnologías: </p>

{
    tecnologias.length > 0 && (
        <div class="project-technologies">
            {
                tecnologias.map((tecnologia: any) => (
                    <span class="project-technology">
                        <img src={tecnologia.icono} width="40" height="40"/>
                    </span>
                ))
            }
        </div>
    )
}

        {
            mostrarEnlaceGitHub ? (
                <a href={enlace} target="_blank" rel="noopener noreferrer">
            <GitHubIcon/>
            GitHub
        </a>
            ):( 
        <button class="github-disabled" disabled>
                    <GitHubIcon />
                    Código privado
                </button>
            )
        }
    </div>
</article>
