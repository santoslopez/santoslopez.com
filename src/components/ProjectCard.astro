---
import GitHubIcon from "./icons/GitHubIcon.astro";
const {
    titulo,
    descripcion,
    imagen,
    enlace
} = Astro.props;
---

<article class="project">
    <img src={imagen} alt={titulo} class="project-image">
    <div class="project-info">
        <h2>{titulo}</h2>
        <p>{descripcion}</p>
        <a href={enlace} target="_blank" rel="noopener noreferrer">
            
            <GitHubIcon/>
            GitHub
        </a>
    </div>
</article>
