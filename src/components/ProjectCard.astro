---
import GitHubIcon from "./icons/GitHubIcon.astro";
const {
    titulo,
    descripcion,
    imagen,
    enlace,
    mostrarEnlaceGitHub = true 
} = Astro.props;
---
<article class="project">
    <img src={imagen} alt={titulo} class="project-image">
    <div class="project-info">
        <h2>{titulo}</h2>
        <p>{descripcion}</p>
        {
            mostrarEnlaceGitHub ? (
                <a href={enlace} target="_blank" rel="noopener noreferrer">
            <GitHubIcon/>
            GitHub
        </a>
            ):( 
        <button class="github-disabled" disabled>
                    <GitHubIcon />
                    Código privado
                </button>
            )
        }
    </div>
</article>
