---
import GitHubIcon from "./icons/GitHubIcon.astro";

import { Image } from "astro:assets"; 

const {
    id,
    tituloTema,
    fechaPublicacion,
    descripcionPrevia,
    imagenPrevia,
    enlace,
    mostrarEnlaceGitHub = true 
} = Astro.props;
---
<article class="project">
    <Image src={imagenPrevia} alt={tituloTema} class="project-image"/>
    
    <div class="project-info">
        <h2><a href={`/proyectos/${id}`}>{tituloTema}</a></h2>
         <p>{ fechaPublicacion}</p>           

        <p>{descripcionPrevia}</p>
        {
            mostrarEnlaceGitHub ? (
                <a href={enlace} target="_blank" rel="noopener noreferrer">
            <GitHubIcon/>
            GitHub
        </a>
            ):( 
        <button class="github-disabled" disabled>
                    <GitHubIcon />
                    Código privado
                </button>
            )
        }
    </div>
</article>
