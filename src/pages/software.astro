---
/**necesario para respetar el cuerpo de la pagina index.
 * donde va todo el contenido, que respeta el espacio entre
 * lateral izquierda y derecha.
 */
import "../styles/index.css";
import "../styles/project-card.css";

import Layout from "../layouts/Layout.astro";

import Software from "../components/SoftwareCard.astro";

import { getCollection  } from "astro:content";

const misProyectos = await getCollection("software");

/**
 * necesario para ordener los archivos markdown por 
 * fechaPublicacion, por la fecha mas reciente
 */
misProyectos.sort(
    (a,b) =>
        b.data.fechaPublicacion.getTime()-
        a.data.fechaPublicacion.getTime()
);

