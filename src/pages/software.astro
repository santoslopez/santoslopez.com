---

<Layout TITULO_PAGINA ="Proyectos"
    META_DESCRIPTION="Explora los proyectos de software de Santos López, incluyendo aplicaciones web, sistemas de gestión y soluciones desarrolladas con tecnologías como Java, PHP, Python, MySQL, PostgreSQL, etc."
>
    <section class="intro content-width">
        <h1>Proyectos</h1>
        <p>
            Puedes encontrar más de mis proyectos de software en <a href="https://github.com/santoslopez">GitHub</a>.
        </p>
{
    misProyectos.map((proyecto) => (
        <Software
            id={proyecto.id}
            tituloTema={proyecto.data.tituloTema}
            fechaPublicacion={proyecto.data.fechaPublicacion}
            descripcionPrevia={proyecto.data.descripcionPrevia}
            imagenPrevia={proyecto.data.imagenPrevia}
            tecnologias={proyecto.data.tecnologias}
            enlace={proyecto.data.enlace}
            mostrarEnlaceGitHub={proyecto.data.mostrarEnlaceGitHub}
        />
    ))
}
