---
/**es el archivo que tiene el index.css que se usa en index.astro */
import "../styles/index.css";
import Layout from "../layouts/Layout.astro";
// importamos los svg de los iconos
import GithubIcon from "../components/GitHubIcon.astro";
import InstagramIcon from "../components/InstagramIcon.astro";
import LinkedInIcon from "../components/LinkedInIcon.astro";
import GmailIcon from "../components/GmailIcon.astro";
---

<Layout TITULO_PAGINA ="Santos López">
	<section class="profile content-width">
		<img src="/santoslopez.png" alt="Foto SantosLopez" class="profile-image">
		<div class="profile-info">
			<h1>SANTOS LÓPEZ</h1>
			<p class="professions">
				<span class="separator">•</span>
				Software Developer
    <span class="separator">•</span>
    Systems Engineer
	<span class="separator">•</span>M.Sc
</p>
			<div class="social-links">
				<button id="idGithub" aria-label="GitHub"><a href="https://github.com/santoslopez" aria-label="GitHub" class="github" target="_blank" rel="noopener noreferrer">
<GithubIcon/>
					GitHub</a></button>
				<button id="idGmail" aria-label="Gmail"><a href="mailto:santos.lopez@galileo.edu" aria-label="Email" class="gmail">
					<GmailIcon></GmailIcon>
					Email</a></button>
				<button id="idInstagram" aria-label="Instagram"><a href="https://vsco.co/santoslopez-" aria-label="Instagram" class="instagram" target="_blank">
<InstagramIcon/>
    Instagram</a></button>
				<button id="idLinkedIn" aria-label="LinkedIn"><a class="linkedin" href="https://www.linkedin.com/in/lopezsantos" aria-label="LinkedIn">
<LinkedInIcon/>
					LinkedIn</a></button>
				
			</div>
		</div>
	</section>

	<section class="intro content-width">
		<h2>¡Hola!</h2>
  <p>
        Soy ingeniero de sistemas, informática y ciencias de la computación
        y desarrollador de software. Cuento con una Maestría en Tecnologías
        de la Información, que completé mediante dos postgrados: uno en
        Bases de Datos y otro en Sistemas de la Información.
    </p>

    <p>
        Me interesa el desarrollo de software, la educación y la creación
        de herramientas que puedan ser útiles para otras personas.
    </p>
	</section>
</Layout>

