---
import "../styles/index.css";
import Layout from "../layouts/Layout.astro";
---
<Layout TITULO_PAGINA="Contactar"
META_DESCRIPTION="Contacta con Santos López para consultas, proyectos, colaboraciones y oportunidades relacionadas con tecnología y desarrollo de software.">
    <section class="intro content-width">
        <h1>Contactar</h1>
        <div id="resultado"></div>
        <!--form action="https://api.web3forms.com/submit" method="POST" class="contact-form"-->
        <form id="form" class="contact-form">
  <input type="hidden" name="access_key" value="36fa1a86-c8a5-4038-a86c-c54c5dfdd977">
<label for="name">Nombre</label>
  <input type="text" id="name" name="name" required>
  <label for="email">Correo electrónico</label>
  <input type="email" id="email" name="email" required>
   <label for="message">Mensaje</label>
  <textarea name="message" required></textarea>
  <button type="submit">Enviar</button>
</form>
<p class="direct-email">
    También puedes escribirme directamente a <a href="mailto:santos.lopez@galileo.edu">
        santos.lopez@galileo.edu
    </a>
</p>
    </section>
</Layout>


<!-- astro formulario -->
 <script>
    const form = document.getElementById("form") as HTMLFormElement;
    const result = document.getElementById("resultado") as HTMLElement;

    form.addEventListener("submit",async (e)=>{
        e.preventDefault();

        result.className = "alert alert-sending";
        result.innerHTML = "Enviando correo...";

        const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            body: new FormData(form),
        });

        const data = await response.json();

        if(data.success){
            
            // exito
            result.className = "alert alert-success";
            result.innerHTML = "Mensaje enviado satisfactoriamente";
            form.reset();
            
            // luego de 3 segundos ocultar
            setTimeout(() => {
                result.innerHTML = "";
                result.className = "";
            },4000);

        }else{
            result.className = "alert alert-error";
            result.innerHTML = data.message;
        }
    })

 </script>

<style>
    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-width: 600px;
        margin-top: 25px;
    }

    .contact-form label {
        margin-top: 10px;
        font-size: 15px;
    }

    .contact-form input,
    .contact-form textarea {
        width: 100%;
        box-sizing: border-box;

        padding: 10px 12px;

        border: 1px solid #ccc;
        border-radius: 5px;

        background: var(--background);
        color: var(--text);

        font-family: inherit;
        font-size: 15px;
    }

    .contact-form textarea {
        resize: vertical;
        min-height: 140px;
    }

    .contact-form input:focus,
    .contact-form textarea:focus {
        outline: none;
        border-color: var(--link);
    }

    .contact-form button {
        align-self: flex-start;

        margin-top: 12px;

        padding: 9px 16px;

        border: none;
        border-radius: 5px;

        background: var(--link);
        color: white;

        font-family: inherit;
        font-size: 14px;

        cursor: pointer;
    }

    .contact-form button:hover {
        opacity: 0.9;
    }

    #result {
        margin-top: 15px;
    }

    .alert {
        padding: 12px 16px;
        border-radius: 5px;
        font-size: 14px;
    }

    /* Enviando */
    .alert-sending {
        background: #f0f0f0;
        color: #555;
        border: 1px solid #ddd;
    }

    /* Éxito */
    .alert-success {
        background: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
    }

    /* Error */
    .alert-error {
        background: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
    }

    .direct-email {
    margin-top: 25px;
    font-size: 14px;
}
.direct-email a {
    color: var(--link);
    text-decoration: none;
}

.direct-email a:hover {
    text-decoration: underline;
}
</style>