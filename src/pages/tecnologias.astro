---
import "../styles/index.css";
import Layout from "../layouts/Layout.astro";
const tecnologias = [
    {
        categoria: "Lenguajes",
        items: ["Java","Python","PHP","JavaScript"]
    },
    {
        categoria: "Web",
        items: ["HTML","CSS","Astro"]
    },
    {
        categoria:"Base de datos",
        items:["MySQL","PostgreSQL","SQLite","SQL Server"]
    },
    {
        categoria:"Herramientas",
        items:["Git","GitHub"]
    }
];
// array
const categoriaInicial = tecnologias[0];
---

<Layout TITULO_PAGINA ="Tecnologías">
    <section class="intro content-width">
        <h1>Tecnologías</h1>
        <div class="technology-tabs">
            {
            tecnologias.map((tecnologia) =>(
                <button data-categoria={tecnologia.categoria}
                    data-items={tecnologia.items.join(",")}
                    class:list={{ active: tecnologia === categoriaInicial}}>
                    {tecnologia.categoria}
                    </button>
            ))
            }
        </div>

        <div class="technology-items">
            {
                categoriaInicial.items.map((item)=>(
                <span>{item}</span>
            ))
            }
        </div>
        <!--p style="color:red">Actualmente en construcción.</p-->
    </section>
</Layout>
<script>

    const botones = document.querySelectorAll<HTMLButtonElement>(".technology-tabs button");

    const technologyItems = document.querySelector(".technology-items");

    botones.forEach((boton) => {
        boton.addEventListener("click", () => {


            botones.forEach((boton)=>{
                boton.classList.remove("active");
            });

            boton.classList.add("active");

            const items = boton.dataset.items?.split(",");
            
            if(technologyItems){
                technologyItems.innerHTML = "";
                items?.forEach((item) =>{
                    const elemento = document.createElement("span");
                    elemento.textContent = item;
                    technologyItems.appendChild(elemento);
                })
            }
        });
    }
    )
</script>
<style>
.technology-tabs {
    display: flex;
    gap: 2px;
    padding: 4px;

    background: rgba(128, 128, 128, 0.25);
    border-radius: 6px;

    width: fit-content;
    max-width: 100%;

    overflow-x: auto;
    overflow-y: hidden;

    flex-wrap: nowrap;
}

    .technology-tabs button {
        border: none;
        background: transparent;

        color: var(--text);

        padding: 7px 12px;
        border-radius: 4px;

        cursor: pointer;

        font-family: inherit;
        font-size: 14px;

        transition: background-color 0.15s ease;

        flex-shrink: 0;
    }

    .technology-tabs button.active {
        background: var(--background);
    }

    .technology-items {
        display: flex;
        gap: 20px;
        margin-top: 20px;
    }
</style>