---

<Layout TITULO_PAGINA="Tecnologías"
META_DESCRIPTION="Conoce las tecnologías y herramientas que utiliza Santos López en el desarrollo de software, junto con sus certificaciones y formación en tecnología.">
    <section class="intro content-width">
        <h1>Tecnologías</h1>
        <!--p style="color:red">Actualmente en construcción.</p-->	
        <p>Tecnologías que utilizo.</p>
        <div class="technology-tabs">
            {
                tecnologias.map((tecnologia) => (
                    <button
                        data-categoria={tecnologia.categoria}
                        data-items={JSON.stringify(tecnologia.items)}
                        class:list={{ active: tecnologia === categoriaInicial }}
                    >
                        {tecnologia.categoria}
                    </button>
                ))
            }
        </div>

        <div class="technology-items">
            {
                categoriaInicial.items.map((item) => (
                    <span>
                        <img src={item.icono} alt={item.nombre} width="30" height="30"/>
                        {item.nombre}
                    </span>
                ))
            }
        </div>
        <h2>Formación y certificaciones</h2>
        <p>Selección de cursos y certificaciones complementarios a mi formación en Ingeniería de Sistemas y Tecnologías de la Información.</p>
        {
    certificaciones.map((certificacion) => (
        <CertificationCard 
        tituloCurso={certificacion.tituloCurso}
        enlaceCurso={certificacion.enlaceCurso}    
        descripcion={certificacion.descripcion}
            expedicion={certificacion.expedicion}
            imagen={certificacion.imagen}
            enlaceDiploma={certificacion.enlaceDiploma}
            />
    ))
}
    </section>
</Layout>

<script>
    const botones = document.querySelectorAll<HTMLButtonElement>(
        ".technology-tabs button"
    );

    const technologyItems = document.querySelector(".technology-items");

    botones.forEach((boton) => {
        boton.addEventListener("click", () => {

            botones.forEach((boton) => {
                boton.classList.remove("active");
            });

            boton.classList.add("active");

            const items = JSON.parse(
                boton.dataset.items ?? "[]"
            ) as {nombre: string; icono: string} [];

            if (technologyItems) {
                technologyItems.innerHTML = "";

                items.forEach((item) => {
                    const elemento = document.createElement("span");

                    const icono = document.createElement("img");
                    icono.src = item.icono;
                    icono.alt = item.nombre;
                    icono.width=30;
                    icono.height = 30;

                    elemento.appendChild(icono);
                    elemento.append(item.nombre);
                    technologyItems.appendChild(elemento);
                });
            }
        });
    });
</script>

<style>
    .technology-tabs {
        display: flex;
        gap: 2px;
        padding: 4px;

        background: rgba(128, 128, 128, 0.12);
        border-radius: 6px;

        width: fit-content;
        max-width: 100%;

        overflow-x: auto;
        overflow-y: hidden;

        flex-wrap: nowrap;
    }

    .technology-tabs button {
        border: none;
        background: transparent;

        color: var(--text);

        padding: 7px 12px;
        border-radius: 4px;

        cursor: pointer;

        font-family: inherit;
        font-size: 14px;

        transition: background-color 0.15s ease;

        flex-shrink: 0;
    }

    .technology-tabs button.active {
        background: var(--background);
    }

    .technology-items {
        display: flex;
        /** si ya no cabe en la misma fila
        pasalos a la otra fila*/

        flex-wrap: wrap;
        gap: 20px;
        margin-top: 20px;
    }

    /* =========================================================
       SCROLL HORIZONTAL
       ========================================================= */

    .technology-tabs::-webkit-scrollbar {
        height: 8px;
    }

    .technology-tabs::-webkit-scrollbar-track {
        background: #e5e5e5;
        border-radius: 4px;
    }

    .technology-tabs::-webkit-scrollbar-thumb {
        background: #777;
        border-radius: 4px;
    }

    .technology-tabs::-webkit-scrollbar-thumb:hover {
        background: #555;
    }
</style>