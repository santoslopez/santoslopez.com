---
import "../styles/index.css";
import Layout from "../layouts/Layout.astro";

const tecnologias = [
    {
        categoria: "Lenguajes",
        items: [
            { nombre: "C", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/c/c-original.svg" },
        {   nombre:"Java",
            icono:"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg"
        },
{ nombre: "Python", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg" },
{ nombre: "PHP", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/php/php-original.svg" },
{ nombre: "JavaScript", icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg" }
    ]
    },
{
    categoria: "Web",
    items: [
        {
            nombre: "HTML",
            icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg"
        },
        {
            nombre: "CSS",
            icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg"
        },
        {
            nombre: "Bootstrap",
            icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/bootstrap/bootstrap-original.svg"
        },
        {
            nombre: "Astro",
            icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg"
        }
    ]
},
{
    categoria: "Base de datos",
    items: [
        {
            nombre: "MySQL",
            icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original.svg"
        },
        {
            nombre: "PostgreSQL",
            icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg"
        },
        {
            nombre: "SQLite",
            icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/sqlite/sqlite-original.svg"
        },
        {
            nombre: "SQL Server",
            icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/microsoftsqlserver/microsoftsqlserver-original.svg"
        }
    ]
},
{
    categoria: "Herramientas",
    items: [
        {
            nombre: "Git",
            icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/git/git-original.svg"
        },
        {
            nombre: "GitHub",
            icono: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg"
        }
    ]
}
];

// Array
const categoriaInicial = tecnologias[0];
---

<Layout TITULO_PAGINA="Tecnologías">
    <section class="intro content-width">
        <h1>Tecnologías</h1>
        <p>Tecnologías con las que he trabajado en proyectos personales y académicos.</p>
        <div class="technology-tabs">
            {
                tecnologias.map((tecnologia) => (
                    <button
                        data-categoria={tecnologia.categoria}
                        data-items={JSON.stringify(tecnologia.items)}
                        class:list={{ active: tecnologia === categoriaInicial }}
                    >
                        {tecnologia.categoria}
                    </button>
                ))
            }
        </div>

        <div class="technology-items">
            {
                categoriaInicial.items.map((item) => (
                    <span>
                        <img src={item.icono} alt="" width="30" height="30"/>
                        {item.nombre}
                    </span>
                ))
            }
        </div>

        <!-- <p style="color:red">Actualmente en construcción.</p> -->
    </section>
</Layout>

<script>
    const botones = document.querySelectorAll<HTMLButtonElement>(
        ".technology-tabs button"
    );

    const technologyItems = document.querySelector(".technology-items");

    botones.forEach((boton) => {
        boton.addEventListener("click", () => {

            botones.forEach((boton) => {
                boton.classList.remove("active");
            });

            boton.classList.add("active");

            const items = JSON.parse(
                boton.dataset.items ?? "[]"
            ) as {nombre: string; icono: string} [];

            if (technologyItems) {
                technologyItems.innerHTML = "";

                items.forEach((item) => {
                    const elemento = document.createElement("span");

                    const icono = document.createElement("img");
                    icono.src = item.icono;
                    icono.alt = item.nombre;
                    icono.width=18;
                    icono.height = 18;

                    elemento.appendChild(icono);
                    elemento.append(item.nombre);
                    technologyItems.appendChild(elemento);
                });
            }
        });
    });
</script>

<style>
    .technology-tabs {
        display: flex;
        gap: 2px;
        padding: 4px;

        background: rgba(128, 128, 128, 0.12);
        border-radius: 6px;

        width: fit-content;
        max-width: 100%;

        overflow-x: auto;
        overflow-y: hidden;

        flex-wrap: nowrap;
    }

    .technology-tabs button {
        border: none;
        background: transparent;

        color: var(--text);

        padding: 7px 12px;
        border-radius: 4px;

        cursor: pointer;

        font-family: inherit;
        font-size: 14px;

        transition: background-color 0.15s ease;

        flex-shrink: 0;
    }

    .technology-tabs button.active {
        background: var(--background);
    }

    .technology-items {
        display: flex;
        gap: 20px;
        margin-top: 20px;
    }

    /* =========================================================
       SCROLL HORIZONTAL
       ========================================================= */

    .technology-tabs::-webkit-scrollbar {
        height: 8px;
    }

    .technology-tabs::-webkit-scrollbar-track {
        background: #e5e5e5;
        border-radius: 4px;
    }

    .technology-tabs::-webkit-scrollbar-thumb {
        background: #777;
        border-radius: 4px;
    }

    .technology-tabs::-webkit-scrollbar-thumb:hover {
        background: #555;
    }
</style>