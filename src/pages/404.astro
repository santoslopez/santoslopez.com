---
import "../styles/index.css";
import Layout from "../layouts/Layout.astro";
import "../styles/error404.css";
---

<Layout>
    <section class="error content-width">
        <h1 style="color:red">404</h1>
        <h2>Página no encontrada</h2>
        <p>Parece que la página que buscas no existe, fue movida o la dirección que escribiste no es correcta.</p>
        <a href="/" class="back-button">Regresar a inicio</a>
    </section>
</Layout>
