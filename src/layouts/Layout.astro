---


/** Astro.pons significa que nuesto Layout puede recibir información
 * desde una página
*/
const {TITULO_PAGINA = "SANTOS LOPEZ" } = Astro.props;

/** 
 * meta description variable
*/
const { META_DESCRIPTION  =  " " } = Astro.props;

//const paginaActual = Astro.url.pathname;
const paginaActual = Astro.url.pathname.replace(/\/$/, "") || "/";;

const yearActual = new Date().getFullYear();

import LunaIcon from "../components/icons/LunaIcon.astro";
import "../styles/layout.css";
---
<html lang="es">
    <head>
        <title>{TITULO_PAGINA}</title>
        <meta name="description" content={META_DESCRIPTION}>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width"/>
        <meta name="robots" content="index, follow"/>
        <meta name="googlebot" content="index, follow, max-snippet:-1,max-image-preview:large,max-video-preview:-1"/>
        <meta name="author" content="Santos López"/>
        <meta property="og:locale" content="es_ES"/>
        <meta property="og:site_name" content="santoslopez.com">    
        <meta property="og:type" content="website"/>
        <meta property="og:url" content="https://santoslopez.com"/>

    <link rel="apple-touch-icon" sizes="120x120" href="profile/apple-touch-icon-120x120.png"/>
    <link rel="apple-touch-icon" sizes="144x144" href="profile/apple-touch-icon-144x144.png"/>
    <link rel="apple-touch-icon" sizes="152x152" href="profile/apple-touch-icon-152x152.png"/>
    <link rel="apple-touch-icon" sizes="180x180" href="profile/apple-touch-icon-180x180.png"/>
    <link rel="icon" type="image/png" href="/favicon.png" />

    </head>

    <body>
        <nav>
            <div class="container nav-container">
                <a href="/" class="site-name">SANTOS LOPEZ</a>
                <div class="nav-links">
                    <a href="/" class:list={{ active: paginaActual ==="/"}}>
                        Inicio
                    </a>
                    <a href="/software" class:list={{ active:paginaActual ==="/software"}}>
                        Software</a>
                    <a href="/tecnologias" class:list={{ active:paginaActual ==="/tecnologias"}}>
                        Tecnologías</a>
                    <a href="/blog" class:list={{ active:paginaActual ==="/blog"}}>
                        Blog</a>
                    <button id="theme-toggle" aria-label="Cambiar tema">
                        <LunaIcon/>
                    </button>
                </div>

            </div>
        </nav>
        <!-- linea que va debajo del menu de navegacion, donde aparecen
         los enlaces activos -->
        <div class="nav-divider">
        </div>
       
        <main>
            <!-- "Aquí pon el contenido que me dé la página que está utilizando este Layout." 
             
            para eso se usa slot-->
            <slot/>

        </main>

        <!-- linea que va debajo del menu de navegacion, donde aparecen
         los enlaces activos -->
        <div class="footer-divider" style="margin-top: 10vh;">
        </div>
        <!-- footer de la pagina -->
        <footer>
            <div class="container footer-container">
                <span>© {yearActual} <a href="/">Santos López</a></span>
                <a href="mailto:santos.lopez@galileo.edu">
                    santos.lopez@galileo.edu
                </a>
            </div>
        </footer>
    </body>
  


    <script>
        // as HTMLButtonElement para decirle que existe el button
        const themeToggle = document.querySelector("#theme-toggle") as HTMLButtonElement;
        const temaGuardado = localStorage.getItem("theme");

        if (temaGuardado === "dark"){
            document.documentElement.classList.add("dark");
            
        }

function actualizarIcono(){
    const temaOscuro = document.documentElement.classList.contains("dark");

    themeToggle.innerHTML = temaOscuro
        ? `
            <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2"/>
                <path d="M12 20v2"/>
                <path d="m4.93 4.93 1.41 1.41"/>
                <path d="m17.66 17.66 1.41 1.41"/>
                <path d="M2 12h2"/>
                <path d="M20 12h2"/>
                <path d="m6.34 17.66-1.41 1.41"/>
                <path d="m19.07 4.93-1.41 1.41"/>
            </svg>
        `
        : `
            <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
            </svg>
        `;
}
        actualizarIcono();
        themeToggle.addEventListener("click", () => {
            //document.documentElement.classList.toggle("dark");
            const temaOscuro = document.documentElement.classList.toggle("dark");
            localStorage.setItem("theme",temaOscuro ? "dark" : "light");
            actualizarIcono();
        });

    </script>
</html>